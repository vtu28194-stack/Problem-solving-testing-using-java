import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {
            String s = sc.next();

            long sum = 0;

            for (int i = 0; i < s.length(); i++) {
                int count = 0;

                while (i + count < s.length()
                        && s.charAt(count) == s.charAt(i + count)) {
                    count++;
                }

                sum += count;
            }

            System.out.println(sum);
        }

        sc.close();
    }
}
